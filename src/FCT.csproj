<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows app: the standby process has no window; the tool opens its own console (NativeConsole). -->
    <OutputType>WinExe</OutputType>
    <!-- Windows.Graphics.Capture reads the post-match treasure screen from the game window: runs on Windows 10 2004+,
         built against the Windows 11 SDK (borderless capture where available). -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <!-- FCT.exe; Windows shows the long name (Task Manager, file properties). -->
    <AssemblyName>FCT</AssemblyName>
    <Product>Fortnite Chest Tracker</Product>
    <AssemblyTitle>Fortnite Chest Tracker</AssemblyTitle>
    <RootNamespace>FCT</RootNamespace>
    <Version>4.4.1</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Single-file publish: the parser discovers its types by reflection, so no trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Small idle footprint: workstation, non-concurrent GC (no background GC thread) and a GC that gives memory back. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <!-- Also inside the exe as a resource: the report shows it as its logo. -->
    <EmbeddedResource Include="Assets\app.ico" LogicalName="FCT.app.ico" />
    <!-- Languages besides Spanish and English: one file per language (see Localization/Languages/README.md). -->
    <EmbeddedResource Include="Localization\Languages\*.json" LogicalName="FCT.lang.%(Filename).json" />
    <!-- fortnite-api.com key to look up the player's total matches (estimate of the chests before FCT). It comes from
         the FORTNITE_API_KEY environment variable (a GitHub secret in the release build); empty = typed by hand. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FortniteApiKey</_Parameter1>
      <_Parameter2>$(FORTNITE_API_KEY)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\external\FortniteReplayDecompressor\FortniteReplayReader\FortniteReplayReader.csproj" />
  </ItemGroup>
</Project>
