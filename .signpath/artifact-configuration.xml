<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for FCT (copy it into the project's artifact configuration on SignPath).
  The workflow uploads a GitHub artifact (a zip) that contains only FCT.exe; SignPath signs that exe with Authenticode.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="FCT.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
